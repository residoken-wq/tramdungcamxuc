# Database Connection (Postgres)
DATABASE_URI=postgres://postgres:password@127.0.0.1:5432/tramdungcamxuc

# Generate a NEW secret for each deployment: openssl rand -hex 32
PAYLOAD_SECRET=

# Địa chỉ site đọc lúc chạy, vd. http://IP-SERVER:3400 cho demo
SITE_URL=

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set true to let demo visitors view /styleguide; leave empty otherwise.
STYLEGUIDE_PUBLIC=

# Optional Cloudflare R2 storage. Missing credentials use local disk.
# S3_REGION defaults to auto when empty. Never expose these values to the browser.
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Dev Postgres host port (change it if 5432 is taken; keep DATABASE_URI in sync).
POSTGRES_PORT=5432

# Docker demo: one exposed app port; Postgres stays internal.
APP_PORT=3000
# Image GHCR cho bản demo (để trống = mặc định ghcr.io/residoken-wq/tramdungcamxuc)
APP_IMAGE=
# Tag image cho bản demo (để trống = mặc định latest).
# Đặt APP_TAG=sha-xxxxxxx (7 ký tự commit) để ghim phiên bản hoặc rollback.
APP_TAG=
# Generate a hex password (URI-safe): openssl rand -hex 32
POSTGRES_PASSWORD=
# Set true on demo servers. Empty allows indexing.
SITE_NOINDEX=

# Transactional email (Resend). Leave empty in local dev to use console log sender.
RESEND_API_KEY=
# Sender email (defaults to "TRAM DUNG CAM XUC <no-reply@tramdungcamxuc.com>" if empty)
EMAIL_FROM=

# Cloudflare Turnstile anti-bot verification.
# In dev/test: bypassed when empty. In production: required for public forms.
# Production builds reject forms without these. Local/QA production runs can use Cloudflare's
# always-pass test keys: secret 1x0000000000000000000000000000000AA, site 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Scheduled cron secret (protects /api/cron/expire-orders)
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=

# Payment sandbox mode (set to true on preview/demo environments to show mock transfer notice)
PAYMENT_SANDBOX=

# Payment Provider (T2-09)
# Chọn 'manual' (mặc định) cho VietQR xác nhận thủ công; 'sepay' khi dùng webhook SePay tự động.
PAYMENT_PROVIDER=
# API Key SePay cấu hình trong webhook SePay (chỉ cần khi PAYMENT_PROVIDER=sepay).
SEPAY_WEBHOOK_API_KEY=


# Content Security Policy (T1-15b).
# Mặc định để trống hoặc false: dùng Content-Security-Policy-Report-Only (không chặn).
# Đặt true trên production sau khi kiểm tra không có vi phạm để bật Content-Security-Policy chặn thật.
CSP_ENFORCE=false

# Video Provider (T2-05a / T2-05b)
# Chọn 'sandbox' (mặc định) cho môi trường nội bộ/dev; 'bunny' cho môi trường production.
VIDEO_PROVIDER=sandbox
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
