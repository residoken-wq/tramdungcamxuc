# Database Connection (Postgres)
DATABASE_URI=postgres://postgres:password@127.0.0.1:5432/tramdungcamxuc

# Payload Secret (min 32 chars)
PAYLOAD_SECRET=tramdungcamxuc_secret_key_change_me_in_production_32chars

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Styleguide Access (để trống trên production, đặt 'true' nếu muốn mở công khai cho CI/E2E test)
STYLEGUIDE_PUBLIC=

# Optional Cloudflare R2 storage. Missing credentials use local disk.
# S3_REGION defaults to auto when empty. Never expose these values to the browser.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
