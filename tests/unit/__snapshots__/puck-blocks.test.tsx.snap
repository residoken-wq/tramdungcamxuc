exports[`T1-01: Puck Blocks – Mở đầu, Nội dung, Bố cục > Snapshot rendering of all 14 blocks with defaultProps > renders PillarCardGrid matching static HTML snapshot 1`] = `"<section class="w-full bg-warm-ivory py-14 px-6 sm:px-12 transition-colors"><div class="mx-auto max-w-6xl"><div class="mb-8 text-left"><span class="mb-3 block font-ui text-xs sm:text-sm font-bold uppercase tracking-widest text-bright-magenta">[MẪU] 03 · NỖI ĐAU</span><h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-deep-navy tracking-tight !leading-[1.25]">[MẪU] Ba kiểu chênh vênh khi AI đổi luật chơi</h2><span class="inline-block w-14 h-1 rounded bg-accent-pink mt-3 mb-1" aria-hidden="true"></span></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch"><div data-eb-card="" class="rounded-2xl p-6 sm:p-7 border shadow-soft flex flex-col gap-5 text-left h-full bg-butter-cream text-deep-navy border-deep-navy/10"><div class="flex items-center gap-2"><span class="font-ui text-xs sm:text-sm font-bold uppercase tracking-wider text-bright-magenta">[MẪU] TRONG HÀNH ĐỘNG</span></div><div class="flex flex-col gap-4 flex-1"><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Học lại mà không duy trì nổi</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Khóa học mua rồi để đó; việc và nhà cuốn đi hết.</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Giá trị của mình mờ đi</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Việc mình giỏi, AI làm nhanh hơn — mình còn khác biệt ở đâu?</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Thấy người khác bứt tốc</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Đồng nghiệp đã dùng AI, đã có tiếng nói riêng; mình đứng yên.</p></div></div></div><div data-eb-card="" class="rounded-2xl p-6 sm:p-7 border shadow-soft flex flex-col gap-5 text-left h-full bg-soft-pink text-deep-navy border-deep-navy/10"><div class="flex items-center gap-2"><span class="font-ui text-xs sm:text-sm font-bold uppercase tracking-wider text-bright-magenta">[MẪU] TRONG CẢM XÚC</span></div><div class="flex flex-col gap-4 flex-1"><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Lo bị đào thải</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Mỗi tin cắt giảm, mỗi công cụ mới lại một lần chao đảo.</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] So sánh, tự nghi ngờ</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] “Mình có đang tụt lại không?” vang lên mỗi lần lướt mạng.</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Mệt mà không dám dừng</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Sợ dừng lại là bị bỏ lại, nên cứ gồng.</p></div></div></div><div data-eb-card="" class="rounded-2xl p-6 sm:p-7 border shadow-soft flex flex-col gap-5 text-left h-full bg-mint-haze text-deep-navy border-deep-navy/10"><div class="flex items-center gap-2"><span class="font-ui text-xs sm:text-sm font-bold uppercase tracking-wider text-bright-magenta">[MẪU] TRONG GIAO TIẾP</span></div><div class="flex flex-col gap-4 flex-1"><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Khó nói ra giá trị mình</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Khi AI viết thay báo cáo, cách mình nói và kết nối mới là khác biệt.</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Lúc quá cứng, lúc quá mềm</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Chưa tìm được giọng vừa rõ vừa ấm.</p></div><div class="flex flex-col gap-1"><h3 class="font-ui font-bold text-sm sm:text-base text-deep-navy leading-snug">[MẪU] Ngại lên tiếng, đề xuất</h3><p class="font-ui text-xs sm:text-sm leading-relaxed text-deep-navy/80">[MẪU] Không dám hỏi, đàm phán hay xin một vai trò mới.</p></div></div></div></div><p class="mt-8 text-left font-quote text-base sm:text-lg italic text-bright-magenta leading-relaxed">[MẪU] Gốc chung: luật chơi đổi nhanh hơn NỘI LỰC bên trong mỗi chúng ta.</p></div></section>"`;

