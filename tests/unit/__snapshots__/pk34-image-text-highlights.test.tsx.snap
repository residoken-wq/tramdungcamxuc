exports[`PK-34: ImageText highlights and box quote style > 1. Default backward compatibility (no new fields) > renders identical HTML when quoteStyle is line and highlights is empty 1`] = `"<section class="w-full bg-warm-ivory py-14 px-6 sm:px-8 transition-colors"><div class="mx-auto max-w-5xl"><div class="grid grid-cols-1  gap-8 lg:gap-12 items-center"><div class="max-w-3xl mx-auto flex flex-col justify-center"><h2 class="font-display text-3xl sm:text-4xl uppercase tracking-tight !leading-[var(--tdcx-title-lh,1.3)] mb-4"><span class="block text-deep-navy">Tại sao lại là</span> <span class="block text-bright-magenta">Trạm Dừng?</span></h2><div class="space-y-3 mb-6"><p class="font-ui text-base leading-relaxed text-deep-navy/80">Đoạn văn thứ nhất.</p><p class="font-ui text-base leading-relaxed text-deep-navy/80">Đoạn văn thứ hai.</p></div><blockquote class="mb-6 border-l-2 border-accent-pink pl-4 font-quote text-lg sm:text-xl italic leading-relaxed text-deep-navy">“Một nơi để bạn dừng lại và thấu hiểu chính mình.”</blockquote></div></div></div></section>"`;
