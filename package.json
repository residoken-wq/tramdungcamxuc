{
  "name": "tramdungcamxuc",
  "version": "1.0.0",
  "description": "Hệ sinh thái số Trạm Dừng Cảm Xúc",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/index.ts",
    "seed:demo-gd2": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/demo-gd2.ts",
    "seed:demo-gd2:clean": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/demo-gd2-clean.ts",
    "seed:demo-gd2:otp": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/demo-gd2-otp.ts",
    "import:habit": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/import-habit.ts",
    "import:eq": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/import-eq.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "cross-env TZ=UTC PGTZ=UTC vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@puckeditor/core": "0.23.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.90.2",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.32.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11 || ^12"
  }
}
